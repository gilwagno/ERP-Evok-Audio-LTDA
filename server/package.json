{
  "name": "erp-evok-audio-server",
  "version": "1.0.0",
  "description": "Backend ERP EVOK ÁUDIO",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "migration:generate": "node src/scripts/run-sequelize-cli.cjs migration:generate",
    "migration:up": "npm run build && node src/scripts/run-sequelize-cli.cjs db:migrate",
    "migration:down": "node src/scripts/run-sequelize-cli.cjs db:migrate:undo",
    "migration:status": "node src/scripts/run-sequelize-cli.cjs db:migrate:status",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "node scripts/run-api-suite.cjs integration",
    "test:integration:skipped": "jest --runInBand tests/integration",
    "test:edge": "jest --runInBand tests/edge",
    "test:characterization": "node scripts/run-api-suite.cjs characterization",
    "test:coverage": "jest --coverage",
    "test:unit:ci": "node -e \"require('fs').mkdirSync('tmp', { recursive: true })\" && jest --runInBand tests/unit --ci --json --outputFile=tmp/jest-unit.json",
    "test:unit:strict": "npm run test:unit:ci && node scripts/assert-jest-no-skips.cjs tmp/jest-unit.json",
    "test:integration:strict": "node scripts/run-api-suite.cjs integration",
    "test:edge:strict": "node scripts/run-api-suite.cjs edge",
    "test:api:strict": "node scripts/run-api-suite.cjs",
    "scan:secrets": "node scripts/scan-tracked-secrets.cjs",
    "verify:git-refs": "node scripts/verify-git-references.cjs",
    "verify:control-plane": "node scripts/verify-control-plane.cjs",
    "verify:governance": "npm run verify:git-refs && npm run verify:control-plane"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}

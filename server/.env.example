# ============================================
# ERP EVOK ÁUDIO - Configuração de Ambiente
# ============================================

# Servidor
PORT=5000
NODE_ENV=development

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp_evok_audio
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
DB_FORCE_SYNC=false

# JWT (Autenticação)
JWT_SECRET=evok-audio-jwt-secret-mude-aqui
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880


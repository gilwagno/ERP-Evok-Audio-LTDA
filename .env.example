# ===========================================
# ERP EVOK ÁUDIO - Variáveis de Ambiente
# ===========================================

# --- Servidor ---
PORT=5000
NODE_ENV=development

# --- Banco de Dados MongoDB ---
MONGODB_URI=mongodb://localhost:27017/erp-evok-audio

# --- JWT ---
JWT_SECRET=seu-jwt-secret-aqui-mude-em-producao
JWT_EXPIRE=7d

# --- Sistema ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Upload (opcional para Fase 2) ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# --- QR Code (opcional para Fase 2) ---
QR_CODE_URL=http://localhost:5000

# --- Email (opcional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@evokaudio.com.br

